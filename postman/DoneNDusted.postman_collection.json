{
  "info": {
    "name": "Done n Dusted API (LD1)",
    "description": "Visi 15 API metodu plius klaidu demonstracija (404, 400, 409, 422, 201, 204).\nKolekcija pati susikuria ir po saves issivalo, todel ja galima paleisti kiek nori kartu.\nPaleidimas: Postman Runner arba `npx newman run postman/DoneNDusted.postman_collection.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "guildName", "value": "" },
    { "key": "guildA", "value": "" },
    { "key": "guildB", "value": "" },
    { "key": "questId", "value": "" },
    { "key": "logId", "value": "" },
    { "key": "occurredAt", "value": "" }
  ],
  "item": [
    {
      "name": "01 POST /guilds -> 201 (metodas 1)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('guildName', 'Postman Guild ' + Date.now());",
              "pm.collectionVariables.set('occurredAt', new Date(Date.now() - 3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Location antraste nurodo nauja resursa', () => {",
              "  pm.expect(pm.response.headers.get('Location')).to.include('/api/guilds/');",
              "});",
              "pm.test('JSON turinio tipas', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Grazintas sukurtas resursas su id ir createdAt', () => {",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.name).to.eql(pm.collectionVariables.get('guildName'));",
              "  pm.expect(body.createdAt).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('guildA', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/guilds", "host": ["{{baseUrl}}"], "path": ["guilds"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{guildName}}\",\n  \"description\": \"Postman demonstracijai sukurta grupe\"\n}"
        }
      }
    },
    {
      "name": "02 POST /guilds -> 201 (antra grupe grandines testui)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('guildB', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/guilds", "host": ["{{baseUrl}}"], "path": ["guilds"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{guildName}} (B)\",\n  \"description\": \"Naudojama tik neteisingos grandines testui\"\n}"
        }
      }
    },
    {
      "name": "03 GET /guilds -> 200 puslapiuotas sarasas (metodas 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Yra content ir page informacija', () => {",
              "  pm.expect(body.content).to.be.an('array');",
              "  pm.expect(body.page.number).to.eql(0);",
              "  pm.expect(body.page.size).to.eql(2);",
              "  pm.expect(body.page.totalElements).to.be.at.least(2);",
              "});",
              "pm.test('Nuorodos self/first/last pateiktos', () => {",
              "  pm.expect(body.links.self).to.be.a('string');",
              "  pm.expect(body.links.first).to.be.a('string');",
              "  pm.expect(body.links.last).to.be.a('string');",
              "});",
              "pm.test('Nuorodose islaikomas filtras', () => {",
              "  pm.expect(body.links.self).to.include('name=Postman');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/guilds?name=Postman&page=0&size=2",
          "host": ["{{baseUrl}}"],
          "path": ["guilds"],
          "query": [
            { "key": "name", "value": "Postman" },
            { "key": "page", "value": "0" },
            { "key": "size", "value": "2" }
          ]
        }
      }
    },
