              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "const e = pm.response.json();",
              "pm.test('ApiError struktura', () => {",
              "  pm.expect(e.status).to.eql(409);",
              "  pm.expect(e.error).to.eql('Conflict');",
              "  pm.expect(e.path).to.eql('/api/guilds');",
              "  pm.expect(e.message).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/guilds", "host": ["{{baseUrl}}"], "path": ["guilds"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{guildName}}\"\n}" }
      }
    },
    {
      "name": "07 POST /guilds blogas payload -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
